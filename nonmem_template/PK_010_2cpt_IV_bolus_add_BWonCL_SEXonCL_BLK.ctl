$PROBLEM 2-cpt IV_bolus Model | FOCE | add

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN3 TRANS4

$PK
; Typical values
TVCL = THETA(1)
TVV1 = THETA(2)
TVQ = THETA(3)
TVV2 = THETA(4)

; Covariate effects
FBWCL = (BW/70)**0.75
IF (SEX.EQ.2) THEN
  FSEX = THETA(5)
ELSE
  FSEX = 1
ENDIF

; Individual parameters
CL = TVCL * EXP(ETA(1)) * FBWCL * FSEX
V1 = TVV1 * EXP(ETA(2))
Q = TVQ * EXP(ETA(3))
V2 = TVV2 * EXP(ETA(4))
S1 = V1

$ERROR
IPRED = F

Y = IPRED + EPS(1)

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV1
(0, 10) ; THETA(3) TVQ
(0, 50) ; THETA(4) TVV2
1 ; THETA(5) SEXEFF

$OMEGA
BLOCK(2)
0.2         ; ETA(1) CL
0.01 0.2    ; ETA(2) V1

$OMEGA
0.2         ; ETA(3) Q
0.2         ; ETA(4) V2

$SIGMA
0.1 ; Additive variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE12.5
