$PROBLEM 2-cpt PO Model | FOCE | logAdd | TVCL

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN4 TRANS4

$PK
; Typical values
TVCLBASE = THETA(1)
TVV2 = THETA(2)
TVQ = THETA(3)
TVV3 = THETA(4)
TVKA = THETA(5)
TVLAG = THETA(6)
TVEMAX = THETA(8)
TVCLT50 = THETA(9)
TVGAMMA = THETA(10)

; Covariate effects
FBWV = (BW/70)**1
IF (SEX.EQ.2) THEN
  FSEX = THETA(7)
ELSE
  FSEX = 1
ENDIF

; Individual parameters
CLBASE = TVCLBASE * EXP(ETA(1)) * FSEX
EMAX = TVEMAX + ETA(7)
CLT50 = TVCLT50
GAMMA = TVGAMMA
CL = CLBASE*EXP((EMAX*(TIME**GAMMA))/(CLT50**GAMMA + TIME**GAMMA))
V2 = TVV2 * EXP(ETA(2)) * FBWV
Q = TVQ * EXP(ETA(3))
V3 = TVV3 * EXP(ETA(4))
KA = TVKA * EXP(ETA(5))
ALAG1 = TVLAG * EXP(ETA(6))
S2 = V2

$ERROR
PKCONC = F

IPRED = LOG(0.0001)
IF (PKCONC.GT.0) IPRED = LOG(PKCONC)

Y = IPRED + EPS(1)

$THETA
(0, 5) ; THETA(1) TVCLBASE
(0, 50) ; THETA(2) TVV2
(0, 10) ; THETA(3) TVQ
(0, 50) ; THETA(4) TVV3
(0, 1) ; THETA(5) TVKA
(0, 1) ; THETA(6) TVLAG
1 ; THETA(7) SEXEFF
0.1 ; THETA(8) TVEMAX
(0.01, 24) ; THETA(9) TVCLT50
(0.01, 1, 10) ; THETA(10) TVGAMMA

$OMEGA
0.2         ; ETA(1) CLBASE
0.2         ; ETA(2) V2
0.2         ; ETA(3) Q
0.2         ; ETA(4) V3
0.2         ; ETA(5) KA
0.2         ; ETA(6) ALAG
0.2         ; ETA(7) EMAX

$SIGMA
0.1 ; Log additive variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE10.4
