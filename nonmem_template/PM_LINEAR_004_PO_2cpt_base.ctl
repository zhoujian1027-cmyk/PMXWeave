$PROBLEM ADVAN5 parent_metabolite_linear PO 2-cpt | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN5

$MODEL COMP=(DEPOT) COMP=(PARENT) COMP=(PERIPH) COMP=(METAB)

$PK
; Typical values
TVCL = THETA(1)
TVV1 = THETA(2)
TVQ = THETA(3)
TVV2 = THETA(4)
TVKA = THETA(5)
TVKPM = THETA(6)
TVCLM = THETA(7)
TVVM = THETA(8)

; Parent PK parameters
CL = TVCL * EXP(ETA(1))
V1 = TVV1 * EXP(ETA(2))
Q = TVQ * EXP(ETA(3))
V2 = TVV2 * EXP(ETA(4))
KA = TVKA * EXP(ETA(5))

; Metabolite formation/disposition
KPM = TVKPM * EXP(ETA(6))
CLM = TVCLM * EXP(ETA(7))
VM = TVVM * EXP(ETA(8))

; ADVAN5 rate constants
K12 = KA
K20 = CL/V1
K23 = Q/V1
K32 = Q/V2
K24 = KPM
K40 = CLM/VM
S2 = V1
S4 = VM

$ERROR
PARENTCONC = A(2)/V1
METABCONC = A(4)/VM

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.2.AND.PARENTCONC.GT.0) THEN
  IPRED = LOG(PARENTCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.4.AND.METABCONC.GT.0) THEN
  IPRED = LOG(METABCONC)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV1
(0, 10) ; THETA(3) TVQ
(0, 50) ; THETA(4) TVV2
(0, 1) ; THETA(5) TVKA
(0, 1) ; THETA(6) TVKPM
(0, 5) ; THETA(7) TVCLM
(0, 50) ; THETA(8) TVVM

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V1
0.2         ; ETA(3) Q
0.2         ; ETA(4) V2
0.2         ; ETA(5) KA
0.2         ; ETA(6) KPM
0.2         ; ETA(7) CLM
0.2         ; ETA(8) VM

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT CWRES NOPRINT ONEHEADER FILE=output
