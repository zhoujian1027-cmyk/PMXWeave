$PROBLEM 1-cpt IV_inf Model | FOCE | add

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN1 TRANS2

$PK
; Typical values
TVCL = THETA(1)
TVV = THETA(2)

; Covariate effects
FAGE = (AGE/40)**THETA(3)

; Individual parameters
CL = TVCL * EXP(ETA(1)) * FAGE
V = TVV * EXP(ETA(2))
S1 = V

$ERROR
IPRED = F

Y = IPRED + EPS(1)

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV
(0, 1) ; THETA(3) AGEPWR

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V

$SIGMA
0.1 ; Additive variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output FORMAT=1F12.5
