$PROBLEM Effect Compartment (emax, inhibitory) 1-cpt IV | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(CENTRAL) COMP=(BIOPHASE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVKE0 = THETA(4)

; Covariate effects
FBWV = (BW/70)**1
FAGE = (AGE/40)**THETA(3)

; PK parameters
CL = TVCL * EXP(ETA(1)) * FAGE
VC = TVVC * EXP(ETA(2)) * FBWV

; PD parameters
KE0 = TVKE0
E0 = THETA(5)
IMAX = THETA(6)
EC50 = THETA(7)

$DES
K10 = CL/VC
DADT(1) = -K10*A(1)
C2 = A(1)/VC
DADT(2) = KE0*(C2 - A(2))

$ERROR
EFFECTCONC = A(2)
PDRESP = E0*(1 - (IMAX*EFFECTCONC)/(EC50+EFFECTCONC))
PKCONC = A(1)/VC

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.1.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.2.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVVC
(0, 1) ; THETA(3) AGEPWR
(0, 1) ; THETA(4) TVKE0
(0, 10) ; THETA(5) TVE0
(0, 1) ; THETA(6) TVIMAX
(0, 100) ; THETA(7) TVEC50

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) VC

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT PDRESP CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE10.4
