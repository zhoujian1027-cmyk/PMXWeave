$PROBLEM Direct Effect (linear, stimulatory) 2-cpt IV | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID DVID BW

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN3 TRANS4

$PK
; Typical values
TVCL = THETA(1)
TVV1 = THETA(2)
TVQ = THETA(3)
TVV2 = THETA(4)

; Covariate effects
FBWCL = (BW/70)**0.75

; PK parameters
CL = TVCL * EXP(ETA(1)) * FBWCL
V1 = TVV1 * EXP(ETA(2))
Q = TVQ * EXP(ETA(3))
V2 = TVV2 * EXP(ETA(4))

; PD parameters
E0 = THETA(5)
SLOPE = THETA(6)
S1 = V1

$ERROR
PKCONC = A(1)/V1
PDRESP = E0 + SLOPE*PKCONC

IPRED = LOG(0.0001)
Y     = IPRED

IF (DVID.EQ.1.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (DVID.EQ.2.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV1
(0, 10) ; THETA(3) TVQ
(0, 50) ; THETA(4) TVV2
(0, 10) ; THETA(5) TVE0
(0, 1) ; THETA(6) TVSLOPE

$OMEGA
BLOCK(2)
0.2         ; ETA(1) CL
0.01 0.2    ; ETA(2) V1

$OMEGA
0.2         ; ETA(3) Q
0.2         ; ETA(4) V2

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED DVID PDRESP CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE10.4
