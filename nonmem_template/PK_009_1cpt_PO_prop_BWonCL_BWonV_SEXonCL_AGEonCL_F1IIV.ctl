$PROBLEM 1-cpt PO Model | FOCE | prop

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN2 TRANS2

$PK
; Typical values
TVCL = THETA(1)
TVV = THETA(2)
TVKA = THETA(3)
TVF1 = THETA(6)

; Covariate effects
FBWCL = (BW/70)**0.75
FBWV = (BW/70)**1
IF (SEX.EQ.2) THEN
  FSEX = THETA(4)
ELSE
  FSEX = 1
ENDIF
FAGE = (AGE/40)**THETA(5)

; Individual parameters
CL = TVCL * EXP(ETA(1)) * FBWCL * FSEX * FAGE
V = TVV * EXP(ETA(2)) * FBWV
KA = TVKA * EXP(ETA(3))
LGTF1_TV = LOG(TVF1/(1.0-TVF1))
LGTF1 = LGTF1_TV + ETA(4)
F1 = EXP(LGTF1)/(1+EXP(LGTF1))
S2 = V

$ERROR
IPRED = F

Y = IPRED + IPRED * EPS(1)

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV
(0, 1) ; THETA(3) TVKA
1 ; THETA(4) SEXEFF
(0, 1) ; THETA(5) AGEPWR
(0, 0.5, 1) ; THETA(6) TVF1

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V
0.2         ; ETA(3) KA
0.2         ; ETA(4) F1

$SIGMA
0.1 ; Proportional variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output
