$PROBLEM Effect Compartment (emax, inhibitory) 2-cpt IV | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(CENTRAL) COMP=(PERIPH) COMP=(BIOPHASE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVQ = THETA(3)
TVVP = THETA(4)
TVKE0 = THETA(6)

; Covariate effects
FBWV = (BW/70)**1
IF (SEX.EQ.2) THEN
  FSEX = THETA(5)
ELSE
  FSEX = 1
ENDIF

; PK parameters
CL = TVCL * EXP(ETA(1)) * FSEX
VC = TVVC * EXP(ETA(2)) * FBWV
Q = TVQ * EXP(ETA(3))
VP = TVVP * EXP(ETA(4))

; PD parameters
KE0 = TVKE0
E0 = THETA(7)
IMAX = THETA(8)
EC50 = THETA(9)
GAMMA = THETA(10)

$DES
K10 = CL/VC
K12 = Q/VC
K21 = Q/VP
DADT(1) = -K10*A(1) - K12*A(1) + K21*A(2)
DADT(2) = K12*A(1) - K21*A(2)
C2 = A(1)/VC
DADT(3) = KE0*(C2 - A(3))

$ERROR
EFFECTCONC = A(3)
PDRESP = E0*(1 - (IMAX*EFFECTCONC**GAMMA)/(EFFECTCONC**GAMMA+EC50**GAMMA))
PKCONC = A(1)/VC

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.1.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.3.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVVC
(0, 10) ; THETA(3) TVQ
(0, 50) ; THETA(4) TVVP
1 ; THETA(5) SEXEFF
(0, 1) ; THETA(6) TVKE0
(0, 10) ; THETA(7) TVE0
(0, 1) ; THETA(8) TVIMAX
(0, 100) ; THETA(9) TVEC50
(0.1, 1, 10) ; THETA(10) TVGAMMA

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) VC
0.2         ; ETA(3) Q
0.2         ; ETA(4) VP

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT PDRESP CWRES NOPRINT ONEHEADER FILE=output
