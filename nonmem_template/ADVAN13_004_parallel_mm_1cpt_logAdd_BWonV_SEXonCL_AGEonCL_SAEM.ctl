$PROBLEM ADVAN13 Michaelis-Menten elimination 1-cpt | SAEM | logAdd

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(DEPOT) COMP=(CENTRAL)

$PK
; Typical values
TVVC = THETA(1)
TVCL = THETA(2)
TVKA = THETA(3)
TVVMAX = THETA(4)
TVKM = THETA(5)

; MU references
MU_1 = LOG(TVVC)
MU_2 = LOG(TVCL)
MU_3 = LOG(TVKA)
MU_4 = LOG(TVVMAX)
MU_5 = LOG(TVKM)

; Covariate effects
FBWV = (BW/70)**1
IF (SEX.EQ.2) THEN
  FSEX = THETA(6)
ELSE
  FSEX = 1
ENDIF
FAGE = (AGE/40)**THETA(7)

; Individual parameters
VC = EXP(MU_1 + ETA(1)) * FBWV
CL = EXP(MU_2 + ETA(2)) * FSEX * FAGE
KA = EXP(MU_3 + ETA(3))
VMAX = EXP(MU_4 + ETA(4))
KM = EXP(MU_5 + ETA(5))

$DES
K12 = KA
K20 = CL/VC
C2 = A(2)/VC
DADT(1) = -K12*A(1)
DADT(2) = K12*A(1) - K20*A(2) - (VMAX*C2)/(KM+C2)

$ERROR
PKCONC = A(2)/VC

IPRED = LOG(0.0001)
IF (PKCONC.GT.0) IPRED = LOG(PKCONC)

Y = IPRED + EPS(1)

$THETA
(0, 50) ; THETA(1) TVVC
(0, 5) ; THETA(2) TVCL
(0, 1) ; THETA(3) TVKA
(0, 10) ; THETA(4) TVVMAX
(0, 1) ; THETA(5) TVKM
1 ; THETA(6) SEXEFF
(0, 1) ; THETA(7) AGEPWR

$OMEGA
0.1         ; IIV_VC
0.1         ; IIV_CL
0.1         ; IIV_KA
0.1         ; IIV_VMAX
0.1         ; IIV_KM

$SIGMA
0.1 ; Log additive variance

$ESTIMATION METHOD=SAEM INTERACTION NBURN=2000 NITER=1000

$ESTIMATION METHOD=IMP EONLY=1 ISAMPLE=1000 NITER=5
; $COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output
