$PROBLEM Direct Effect (linear, stimulatory) 1-cpt PO | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID DVID

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN2 TRANS2

$PK
; Typical values
TVCL = THETA(1)
TVV = THETA(2)
TVKA = THETA(3)

; Covariate effects

; PK parameters
CL = TVCL * EXP(ETA(1))
V = TVV * EXP(ETA(2))
KA = TVKA * EXP(ETA(3))

; PD parameters
E0 = THETA(4)
SLOPE = THETA(5)
S2 = V

$ERROR
PKCONC = A(2)/V
PDRESP = E0 + SLOPE*PKCONC

IPRED = LOG(0.0001)
Y     = IPRED

IF (DVID.EQ.1.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (DVID.EQ.2.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV
(0, 1) ; THETA(3) TVKA
(0, 10) ; THETA(4) TVE0
(0, 1) ; THETA(5) TVSLOPE

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V
0.2         ; ETA(3) KA

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED DVID PDRESP CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE12.5
