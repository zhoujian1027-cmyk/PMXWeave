$PROBLEM 3-cpt IV_bolus Model | FOCE | prop | TVCL

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN11 TRANS4

$PK
; Typical values
TVCLBASE = THETA(1)
TVV1 = THETA(2)
TVQ2 = THETA(3)
TVV2 = THETA(4)
TVQ3 = THETA(5)
TVV3 = THETA(6)
TVEMAX = THETA(9)
TVCLT50 = THETA(10)
TVGAMMA = THETA(11)

; Covariate effects
FBWV = (BW/70)**1
IF (SEX.EQ.2) THEN
  FSEX = THETA(7)
ELSE
  FSEX = 1
ENDIF
FAGE = (AGE/40)**THETA(8)

; Individual parameters
CLBASE = TVCLBASE * EXP(ETA(1)) * FSEX * FAGE
EMAX = TVEMAX + ETA(7)
CLT50 = TVCLT50
GAMMA = TVGAMMA
CL = CLBASE*EXP((EMAX*(TIME**GAMMA))/(CLT50**GAMMA + TIME**GAMMA))
V1 = TVV1 * EXP(ETA(2)) * FBWV
Q2 = TVQ2 * EXP(ETA(3))
V2 = TVV2 * EXP(ETA(4))
Q3 = TVQ3 * EXP(ETA(5))
V3 = TVV3 * EXP(ETA(6))
S1 = V1

$ERROR
IPRED = F

Y = IPRED + IPRED * EPS(1)

$THETA
(0, 5) ; THETA(1) TVCLBASE
(0, 50) ; THETA(2) TVV1
(0, 10) ; THETA(3) TVQ2
(0, 50) ; THETA(4) TVV2
(0, 10) ; THETA(5) TVQ3
(0, 50) ; THETA(6) TVV3
1 ; THETA(7) SEXEFF
(0, 1) ; THETA(8) AGEPWR
0.1   ; THETA(9) TVEMAX
(0.01, 24) ; THETA(10) TVCLT50
(0.01, 1, 10) ; THETA(11) TVGAMMA

$OMEGA
BLOCK(2)
0.2         ; ETA(1) CLBASE
0.01 0.2    ; ETA(2) V1

$OMEGA
0.2         ; ETA(3) Q2
0.2         ; ETA(4) V2
0.2         ; ETA(5) Q3
0.2         ; ETA(6) V3
0.2         ; ETA(7) EMAX

$SIGMA
0.1 ; Proportional variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE12.5
