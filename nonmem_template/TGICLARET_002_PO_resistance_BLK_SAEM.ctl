$PROBLEM Claret TGI (SLD) 2-cpt PO | w/ resistance | SAEM

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(DEPOT) COMP=(CENTRAL) COMP=(PERIPH) COMP=(TUMOR)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVKA = THETA(3)
TVQ = THETA(4)
TVVP = THETA(5)
TVBASE = THETA(6)
TVKG = THETA(7)
TVKD = THETA(8)
TVLAMBDA = THETA(9)

; MU references
MU_1 = LOG(TVCL)
MU_2 = LOG(TVVC)
MU_3 = LOG(TVKA)
MU_4 = LOG(TVQ)
MU_5 = LOG(TVVP)
MU_6 = LOG(TVBASE)
MU_7 = LOG(TVKG)
MU_8 = LOG(TVKD)

; PK parameters
CL = EXP(MU_1 + ETA(1))
VC = EXP(MU_2 + ETA(2))
KA = EXP(MU_3 + ETA(3))
Q = EXP(MU_4 + ETA(4))
VP = EXP(MU_5 + ETA(5))

; Tumor growth/kill parameters
BASE = EXP(MU_6 + ETA(6))
KG = EXP(MU_7 + ETA(7))
KD = EXP(MU_8 + ETA(8))
LAMBDA = TVLAMBDA
A_0(4) = BASE

$DES
K12 = KA
K20 = CL/VC
K23 = Q/VC
K32 = Q/VP
DADT(1) = -K12*A(1)
DADT(2) = K12*A(1) + K32*A(3) - K23*A(2) - K20*A(2)
DADT(3) = K23*A(2) - K32*A(3)
C2 = A(2)/VC    ; drug concentration
KILL = KD*C2*EXP(-LAMBDA*T)
DADT(4) = (KG - KILL)*A(4)    ; tumor SLD

$ERROR
PKCONC = A(2)/VC
PDRESP = A(4)

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.2.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.4.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 0.5) ; THETA(1) TVCL
(0, 2) ; THETA(2) TVVC
(0, 1) ; THETA(3) TVKA
(0, 1) ; THETA(4) TVQ
(0, 2) ; THETA(5) TVVP
(0, 8) ; THETA(6) TVBASE
(0, 0.01) ; THETA(7) TVKG
(0, 0.1) ; THETA(8) TVKD
(0, 0.01) ; THETA(9) TVLAMBDA

$OMEGA
BLOCK(2)
0.2         ; ETA(1) CL
0.01 0.2    ; ETA(2) VC

$OMEGA
0.2         ; ETA(3) KA
0.2         ; ETA(4) Q
0.2         ; ETA(5) VP
0.2         ; ETA(6) BASE
0.2         ; ETA(7) KG
0.2         ; ETA(8) KD

$SIGMA
0.1 ; PK log-additive error
0.1 ; Tumor log-additive error

$ESTIMATION METHOD=SAEM INTERACTION NBURN=2000 NITER=1000

$ESTIMATION METHOD=IMP EONLY=1 ISAMPLE=1000 NITER=5
; $COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT CWRES NOPRINT ONEHEADER FILE=output FORMAT=1F12.5
