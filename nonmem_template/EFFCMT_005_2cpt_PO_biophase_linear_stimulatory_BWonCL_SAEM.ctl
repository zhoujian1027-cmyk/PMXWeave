$PROBLEM Effect Compartment (linear, stimulatory) 2-cpt PO | SAEM

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(DEPOT) COMP=(CENTRAL) COMP=(PERIPH) COMP=(BIOPHASE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVKA = THETA(3)
TVQ = THETA(4)
TVVP = THETA(5)
TVKE0 = THETA(6)

; MU references
MU_1 = LOG(TVCL)
MU_2 = LOG(TVVC)
MU_3 = LOG(TVKA)
MU_4 = LOG(TVQ)
MU_5 = LOG(TVVP)

; Covariate effects
FBWCL = (BW/70)**0.75

; PK parameters
CL = EXP(MU_1 + ETA(1)) * FBWCL
VC = EXP(MU_2 + ETA(2))
KA = EXP(MU_3 + ETA(3))
Q = EXP(MU_4 + ETA(4))
VP = EXP(MU_5 + ETA(5))

; PD parameters
KE0 = TVKE0
E0 = THETA(7)
SLOPE = THETA(8)

$DES
K12 = KA
K20 = CL/VC
K23 = Q/VC
K32 = Q/VP
DADT(1) = -K12*A(1)
DADT(2) = K12*A(1) + K32*A(3) - K23*A(2) - K20*A(2)
DADT(3) = K23*A(2) - K32*A(3)
C2 = A(2)/VC
DADT(4) = KE0*(C2 - A(4))

$ERROR
EFFECTCONC = A(4)
PDRESP = E0 + SLOPE*EFFECTCONC
PKCONC = A(2)/VC

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.2.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.4.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVVC
(0, 1) ; THETA(3) TVKA
(0, 10) ; THETA(4) TVQ
(0, 50) ; THETA(5) TVVP
(0, 1) ; THETA(6) TVKE0
(0, 10) ; THETA(7) TVE0
(0, 1) ; THETA(8) TVSLOPE

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) VC
0.2         ; ETA(3) KA
0.2         ; ETA(4) Q
0.2         ; ETA(5) VP

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=SAEM INTERACTION NBURN=2000 NITER=1000

$ESTIMATION METHOD=IMP EONLY=1 ISAMPLE=1000 NITER=5
; $COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT PDRESP CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE10.4
