$PROBLEM ADVAN5 Transit-Compartment Absorption 1-cpt | NTR=3 | FOCE | comb

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN5 TRANS1

$MODEL COMP=(TRANSIT1, DEFDOSE) COMP=(TRANSIT2) COMP=(TRANSIT3) COMP=(CENTRAL, DEFOBSERVATION)

$PK
; Typical values
TVCL = THETA(1)
TVV = THETA(2)
TVMTT = THETA(3)

; Covariate effects
FBWV = (BW/70)**1
IF (SEX.EQ.2) THEN
  FSEX = THETA(4)
ELSE
  FSEX = 1
ENDIF
FAGE = (AGE/40)**THETA(5)

; Individual parameters
CL = TVCL * EXP(ETA(1)) * FSEX * FAGE
V = TVV * EXP(ETA(2)) * FBWV
MTT = TVMTT * EXP(ETA(3))

; Transit absorption chain
NTR = 3
KTR = NTR/MTT

; ADVAN5/TRANS1 rate constants
K12 = KTR
K23 = KTR
K34 = KTR
K40 = CL/V
S4 = V

$ERROR
IPRED = F

Y = IPRED + IPRED * EPS(1) + EPS(2)

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV
(0, 5) ; THETA(3) TVMTT
1 ; THETA(4) SEXEFF
(0, 1) ; THETA(5) AGEPWR

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V
0.2         ; ETA(3) MTT

$SIGMA
0.1 ; Proportional variance
0.1 ; Additive variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output FORMAT=1F12.5
