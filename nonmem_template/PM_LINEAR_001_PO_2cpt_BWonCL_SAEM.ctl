$PROBLEM ADVAN5 parent_metabolite_linear PO 2-cpt | SAEM

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN5

$MODEL COMP=(DEPOT) COMP=(PARENT) COMP=(PERIPH) COMP=(METAB)

$PK
; Typical values
TVCL = THETA(1)
TVV1 = THETA(2)
TVQ = THETA(3)
TVV2 = THETA(4)
TVKA = THETA(5)
TVKPM = THETA(6)
TVCLM = THETA(7)
TVVM = THETA(8)

; MU references
MU_1 = LOG(TVCL)
MU_2 = LOG(TVV1)
MU_3 = LOG(TVQ)
MU_4 = LOG(TVV2)
MU_5 = LOG(TVKA)
MU_6 = LOG(TVKPM)
MU_7 = LOG(TVCLM)
MU_8 = LOG(TVVM)

; Covariate effects
FBWCL = (BW/70)**0.75
IF (SEX.EQ.2) THEN
  FSEX = THETA(9)
ELSE
  FSEX = 1
ENDIF

; Parent PK parameters
CL = EXP(MU_1 + ETA(1)) * FBWCL * FSEX
V1 = EXP(MU_2 + ETA(2))
Q = EXP(MU_3 + ETA(3))
V2 = EXP(MU_4 + ETA(4))
KA = EXP(MU_5 + ETA(5))

; Metabolite formation/disposition
KPM = EXP(MU_6 + ETA(6))
CLM = EXP(MU_7 + ETA(7))
VM = EXP(MU_8 + ETA(8))

; ADVAN5 rate constants
K12 = KA
K20 = CL/V1
K23 = Q/V1
K32 = Q/V2
K24 = KPM
K40 = CLM/VM
S2 = V1
S4 = VM

$ERROR
PARENTCONC = A(2)/V1
METABCONC = A(4)/VM

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.2.AND.PARENTCONC.GT.0) THEN
  IPRED = LOG(PARENTCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.4.AND.METABCONC.GT.0) THEN
  IPRED = LOG(METABCONC)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV1
(0, 10) ; THETA(3) TVQ
(0, 50) ; THETA(4) TVV2
(0, 1) ; THETA(5) TVKA
(0, 1) ; THETA(6) TVKPM
(0, 5) ; THETA(7) TVCLM
(0, 50) ; THETA(8) TVVM
1 ; THETA(9) SEXEFF

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V1
0.2         ; ETA(3) Q
0.2         ; ETA(4) V2
0.2         ; ETA(5) KA
0.2         ; ETA(6) KPM
0.2         ; ETA(7) CLM
0.2         ; ETA(8) VM

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=SAEM INTERACTION NBURN=2000 NITER=1000

$ESTIMATION METHOD=IMP EONLY=1 ISAMPLE=1000 NITER=5
; $COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT CWRES NOPRINT ONEHEADER FILE=output
