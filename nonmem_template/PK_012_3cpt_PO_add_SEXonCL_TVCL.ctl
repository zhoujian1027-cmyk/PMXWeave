$PROBLEM 3-cpt PO Model | FOCE | add | TVCL

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID SEX

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN12 TRANS4

$PK
; Typical values
TVCLBASE = THETA(1)
TVV2 = THETA(2)
TVQ3 = THETA(3)
TVV3 = THETA(4)
TVQ4 = THETA(5)
TVV4 = THETA(6)
TVKA = THETA(7)
TVEMAX = THETA(9)
TVCLT50 = THETA(10)
TVGAMMA = THETA(11)

; Covariate effects
IF (SEX.EQ.2) THEN
  FSEX = THETA(8)
ELSE
  FSEX = 1
ENDIF

; Individual parameters
CLBASE = TVCLBASE * EXP(ETA(1)) * FSEX
EMAX = TVEMAX + ETA(8)
CLT50 = TVCLT50
GAMMA = TVGAMMA
CL = CLBASE*EXP((EMAX*(TIME**GAMMA))/(CLT50**GAMMA + TIME**GAMMA))
V2 = TVV2 * EXP(ETA(2))
Q3 = TVQ3 * EXP(ETA(3))
V3 = TVV3 * EXP(ETA(4))
Q4 = TVQ4 * EXP(ETA(5))
V4 = TVV4 * EXP(ETA(6))
KA = TVKA * EXP(ETA(7))
S2 = V2

$ERROR
IPRED = F

Y = IPRED + EPS(1)

$THETA
(0, 5) ; THETA(1) TVCLBASE
(0, 50) ; THETA(2) TVV2
(0, 10) ; THETA(3) TVQ3
(0, 50) ; THETA(4) TVV3
(0, 10) ; THETA(5) TVQ4
(0, 50) ; THETA(6) TVV4
(0, 1) ; THETA(7) TVKA
1 ; THETA(8) SEXEFF
0.1   ; THETA(9) TVEMAX
(0.01, 24) ; THETA(10) TVCLT50
(0.01, 1, 10) ; THETA(11) TVGAMMA

$OMEGA
0.2         ; ETA(1) CLBASE
0.2         ; ETA(2) V2
0.2         ; ETA(3) Q3
0.2         ; ETA(4) V3
0.2         ; ETA(5) Q4
0.2         ; ETA(6) V4
0.2         ; ETA(7) KA
0.2         ; ETA(8) EMAX

$SIGMA
0.1 ; Additive variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output
