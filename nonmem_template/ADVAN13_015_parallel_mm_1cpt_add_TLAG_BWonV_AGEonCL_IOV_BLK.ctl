$PROBLEM ADVAN13 Michaelis-Menten elimination 1-cpt | FOCE | add

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW AGE OCC

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(DEPOT) COMP=(CENTRAL)

$PK
; Typical values
TVVC = THETA(1)
TVCL = THETA(2)
TVKA = THETA(3)
TVLAG = THETA(4)
TVVMAX = THETA(5)
TVKM = THETA(6)

; Covariate effects
FBWV = (BW/70)**1
FAGE = (AGE/40)**THETA(7)

; Occasion flags
OCC1 = 0
OCC2 = 0
OCC3 = 0
IF (OCC.EQ.1) OCC1 = 1
IF (OCC.EQ.2) OCC2 = 1
IF (OCC.EQ.3) OCC3 = 1
IOVCL = OCC1*ETA(6) + OCC2*ETA(7) + OCC3*ETA(8)

; Individual parameters
VC = TVVC * EXP(ETA(1)) * FBWV
CL = TVCL * EXP(ETA(2)) * FAGE * EXP(IOVCL)
KA = TVKA * EXP(ETA(3))
ALAG1 = TVLAG
VMAX = TVVMAX * EXP(ETA(4))
KM = TVKM * EXP(ETA(5))

$DES
K12 = KA
K20 = CL/VC
C2 = A(2)/VC
DADT(1) = -K12*A(1)
DADT(2) = K12*A(1) - K20*A(2) - (VMAX*C2)/(KM+C2)

$ERROR
IPRED = A(2)/VC

Y = IPRED + EPS(1)

$THETA
(0, 50) ; THETA(1) TVVC
(0, 5) ; THETA(2) TVCL
(0, 1) ; THETA(3) TVKA
(0, 1) ; THETA(4) TVLAG
(0, 10) ; THETA(5) TVVMAX
(0, 1) ; THETA(6) TVKM
(0, 1) ; THETA(7) AGEPWR

$OMEGA
BLOCK(2)
0.2         ; ETA(1) VC
0.01 0.2    ; ETA(2) CL

$OMEGA
0.2         ; ETA(3) KA
0.2         ; ETA(4) VMAX
0.2         ; ETA(5) KM

$OMEGA 0.1         ; IOVCL1

$OMEGA 0.1         ; IOVCL2

$OMEGA 0.1         ; IOVCL3

$SIGMA
0.1 ; Additive variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output
