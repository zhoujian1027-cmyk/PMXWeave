$PROBLEM Indirect Response (stim_kout, emax) 2-cpt IV | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(CENTRAL) COMP=(PERIPH) COMP=(RESPONSE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVQ = THETA(3)
TVVP = THETA(4)
TVR0 = THETA(7)
TVKOUT = THETA(8)
TVEMAX = THETA(9)

; Covariate effects
FBWCL = (BW/70)**0.75
IF (SEX.EQ.2) THEN
  FSEX = THETA(5)
ELSE
  FSEX = 1
ENDIF
FAGE = (AGE/40)**THETA(6)

; PK parameters
CL = TVCL * EXP(ETA(1)) * FBWCL * FSEX * FAGE
VC = TVVC * EXP(ETA(2))
Q = TVQ * EXP(ETA(3))
VP = TVVP * EXP(ETA(4))

; PD parameters
R0 = TVR0 * EXP(ETA(5))
KOUT = TVKOUT * EXP(ETA(6))
KIN = R0 * KOUT
A_0(3) = R0
EMAX = TVEMAX
IC50 = THETA(10)
S1 = VC

$DES
K10 = CL/VC
K12 = Q/VC
K21 = Q/VP
DADT(1) = -K10*A(1) - K12*A(1) + K21*A(2)
DADT(2) = K12*A(1) - K21*A(2)
C2 = A(1)/VC
EFF = EMAX*C2/(IC50+C2)
DADT(3) = KIN - KOUT*(1+EFF)*A(3)

$ERROR
PKCONC = A(1)/VC
PDRESP = A(3)

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.1.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.3.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVVC
(0, 10) ; THETA(3) TVQ
(0, 50) ; THETA(4) TVVP
1 ; THETA(5) SEXEFF
(0, 1) ; THETA(6) AGEPWR
(0, 10) ; THETA(7) TVR0
(0, 0.1) ; THETA(8) TVKOUT
(0, 10) ; THETA(9) TVEMAX
(0, 100) ; THETA(10) TVIC50

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) VC
0.2         ; ETA(3) Q
0.2         ; ETA(4) VP
0.2         ; ETA(5) R0
0.2         ; ETA(6) KOUT

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT CWRES NOPRINT ONEHEADER FILE=output FORMAT=1F12.5
