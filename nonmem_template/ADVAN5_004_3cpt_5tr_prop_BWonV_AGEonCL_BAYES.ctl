$PROBLEM ADVAN5 Transit-Compartment Absorption 3-cpt | NTR=5 | BAYES | prop

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN5 TRANS1

$MODEL COMP=(TRANSIT1, DEFDOSE) COMP=(TRANSIT2) COMP=(TRANSIT3) COMP=(TRANSIT4) COMP=(TRANSIT5) COMP=(CENTRAL, DEFOBSERVATION) COMP=(PERIPH1) COMP=(PERIPH2)

$PK
; Typical values
TVCL = THETA(1)
TVV2 = THETA(2)
TVMTT = THETA(3)
TVQ3 = THETA(4)
TVV3 = THETA(5)
TVQ4 = THETA(6)
TVV4 = THETA(7)

; Covariate effects
FBWV = (BW/70)**1
FAGE = (AGE/40)**THETA(8)

; Individual parameters
CL = TVCL * EXP(ETA(1)) * FAGE
V2 = TVV2 * EXP(ETA(2)) * FBWV
MTT = TVMTT * EXP(ETA(3))
Q3 = TVQ3 * EXP(ETA(4))
V3 = TVV3 * EXP(ETA(5))
Q4 = TVQ4 * EXP(ETA(6))
V4 = TVV4 * EXP(ETA(7))

; Transit absorption chain
NTR = 5
KTR = NTR/MTT

; ADVAN5/TRANS1 rate constants
K12 = KTR
K23 = KTR
K34 = KTR
K45 = KTR
K56 = KTR
K60 = CL/V2
K67 = Q3/V2
K76 = Q3/V3
K68 = Q4/V2
K86 = Q4/V4
S6 = V2

$ERROR
IPRED = F

Y = IPRED + IPRED * EPS(1)

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV2
(0, 5) ; THETA(3) TVMTT
(0, 10) ; THETA(4) TVQ3
(0, 50) ; THETA(5) TVV3
(0, 10) ; THETA(6) TVQ4
(0, 50) ; THETA(7) TVV4
(0, 1) ; THETA(8) AGEPWR

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V2
0.2         ; ETA(3) MTT
0.2         ; ETA(4) Q3
0.2         ; ETA(5) V3
0.2         ; ETA(6) Q4
0.2         ; ETA(7) V4

$SIGMA
0.1 ; Proportional variance

$PRIOR NWPRI

$THETAP
5 FIX
50 FIX
5 FIX
10 FIX
50 FIX
10 FIX
50 FIX
1 FIX

$THETAPV BLOCK(8) FIX
1000
0 1000
0 0 1000
0 0 0 1000
0 0 0 0 1000
0 0 0 0 0 1000
0 0 0 0 0 0 1000
0 0 0 0 0 0 0 1000

$ESTIMATION METHOD=BAYES INTERACTION FILE=bayes_output

; $COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output
