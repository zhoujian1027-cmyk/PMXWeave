$PROBLEM Indirect Response (stim_kout, linear) 2-cpt PO | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(DEPOT) COMP=(CENTRAL) COMP=(PERIPH) COMP=(RESPONSE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVKA = THETA(3)
TVQ = THETA(4)
TVVP = THETA(5)
TVR0 = THETA(7)
TVKOUT = THETA(8)

; Covariate effects
FAGE = (AGE/40)**THETA(6)

; PK parameters
CL = TVCL * EXP(ETA(1)) * FAGE
VC = TVVC * EXP(ETA(2))
KA = TVKA * EXP(ETA(3))
Q = TVQ * EXP(ETA(4))
VP = TVVP * EXP(ETA(5))

; PD parameters
R0 = TVR0 * EXP(ETA(6))
KOUT = TVKOUT * EXP(ETA(7))
KIN = R0 * KOUT
A_0(4) = R0
SLOPE = THETA(9)
S2 = VC

$DES
K12 = KA
K20 = CL/VC
K23 = Q/VC
K32 = Q/VP
DADT(1) = -K12*A(1)
DADT(2) = K12*A(1) + K32*A(3) - K23*A(2) - K20*A(2)
DADT(3) = K23*A(2) - K32*A(3)
C2 = A(2)/VC
EFF = SLOPE*C2
DADT(4) = KIN - KOUT*(1+EFF)*A(4)

$ERROR
PKCONC = A(2)/VC
PDRESP = A(4)

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.2.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.4.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVVC
(0, 1) ; THETA(3) TVKA
(0, 10) ; THETA(4) TVQ
(0, 50) ; THETA(5) TVVP
(0, 1) ; THETA(6) AGEPWR
(0, 10) ; THETA(7) TVR0
(0, 0.1) ; THETA(8) TVKOUT
(0, 1) ; THETA(9) TVSLOPE

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) VC
0.2         ; ETA(3) KA
0.2         ; ETA(4) Q
0.2         ; ETA(5) VP
0.2         ; ETA(6) R0
0.2         ; ETA(7) KOUT

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT CWRES NOPRINT ONEHEADER FILE=output
