$PROBLEM Direct Effect (emax, stimulatory) 2-cpt PO | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID DVID BW

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN4 TRANS4

$PK
; Typical values
TVCL = THETA(1)
TVV2 = THETA(2)
TVKA = THETA(3)
TVQ = THETA(4)
TVV3 = THETA(5)

; Covariate effects
FBWCL = (BW/70)**0.75

; PK parameters
CL = TVCL * EXP(ETA(1)) * FBWCL
V2 = TVV2 * EXP(ETA(2))
KA = TVKA * EXP(ETA(3))
Q = TVQ * EXP(ETA(4))
V3 = TVV3 * EXP(ETA(5))

; PD parameters
E0 = THETA(6)
EMAX = THETA(7)
EC50 = THETA(8)
S2 = V2

$ERROR
PKCONC = A(2)/V2
PDRESP = E0 + (EMAX*PKCONC)/(EC50+PKCONC)

IPRED = LOG(0.0001)
Y     = IPRED

IF (DVID.EQ.1.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (DVID.EQ.2.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV2
(0, 1) ; THETA(3) TVKA
(0, 10) ; THETA(4) TVQ
(0, 50) ; THETA(5) TVV3
(0, 10) ; THETA(6) TVE0
(0, 10) ; THETA(7) TVEMAX
(0, 100) ; THETA(8) TVEC50

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V2
0.2         ; ETA(3) KA
0.2         ; ETA(4) Q
0.2         ; ETA(5) V3

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED DVID PDRESP CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE12.5
