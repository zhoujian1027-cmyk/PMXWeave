$PROBLEM Effect Compartment (emax, inhibitory) 1-cpt PO | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(DEPOT) COMP=(CENTRAL) COMP=(BIOPHASE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVKA = THETA(3)
TVKE0 = THETA(5)

; Covariate effects
FBWCL = (BW/70)**0.75
FAGE = (AGE/40)**THETA(4)

; PK parameters
CL = TVCL * EXP(ETA(1)) * FBWCL * FAGE
VC = TVVC * EXP(ETA(2))
KA = TVKA * EXP(ETA(3))

; PD parameters
KE0 = TVKE0 * EXP(ETA(4))
E0 = THETA(6)
IMAX = THETA(7)
EC50 = THETA(8)

$DES
K12 = KA
K20 = CL/VC
DADT(1) = -K12*A(1)
DADT(2) = K12*A(1) - K20*A(2)
C2 = A(2)/VC
DADT(3) = KE0*(C2 - A(3))

$ERROR
EFFECTCONC = A(3)
PDRESP = E0*(1 - (IMAX*EFFECTCONC)/(EC50+EFFECTCONC))
PKCONC = A(2)/VC

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.2.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.3.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVVC
(0, 1) ; THETA(3) TVKA
(0, 1) ; THETA(4) AGEPWR
(0, 1) ; THETA(5) TVKE0
(0, 10) ; THETA(6) TVE0
(0, 1) ; THETA(7) TVIMAX
(0, 100) ; THETA(8) TVEC50

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) VC
0.2         ; ETA(3) KA
0.2         ; ETA(4) KE0

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT PDRESP CWRES NOPRINT ONEHEADER FILE=output
