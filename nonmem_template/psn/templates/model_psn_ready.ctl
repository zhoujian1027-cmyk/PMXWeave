$PROBLEM PSN-READY BASE | 1-CMT PO | FOCEI | PROP  (template, not a fit)

$DATA pk_data.csv

$INPUT ID TIME DV AMT EVID CMT MDV WGT AGE SEX CRCL STUDY

$SUBROUTINES ADVAN2 TRANS2

$PK
; Typical values
TVCL = THETA(1)
TVV = THETA(2)
TVKA = THETA(3)

;CONCOMITANT = 70
;;;SCM-ANCHOR

; Individual parameters
CL = TVCL * EXP(ETA(1))
V = TVV * EXP(ETA(2))
KA = TVKA * EXP(ETA(3))
S2 = V

$ERROR
IPRED = F
W = IPRED

Y = IPRED + W * EPS(1)

$THETA
(0, 5) ; TVCL
(0, 50) ; TVV
(0, 1) ; TVKA

$OMEGA
0.2         ; CL
0.2         ; V
0.2         ; KA

$SIGMA
0.1 ; Proportional variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=base_tab FORMAT=1F12.5
