$PROBLEM 3-cpt IV_inf Model | FOCE | comb

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN11 TRANS4

$PK
; Typical values
TVCL = THETA(1)
TVV1 = THETA(2)
TVQ2 = THETA(3)
TVV2 = THETA(4)
TVQ3 = THETA(5)
TVV3 = THETA(6)

; Covariate effects
FBWCL = (BW/70)**0.75
FBWV = (BW/70)**1

; Individual parameters
CL = TVCL * EXP(ETA(1)) * FBWCL
V1 = TVV1 * EXP(ETA(2)) * FBWV
Q2 = TVQ2 * EXP(ETA(3))
V2 = TVV2 * EXP(ETA(4))
Q3 = TVQ3 * EXP(ETA(5))
V3 = TVV3 * EXP(ETA(6))
S1 = V1

$ERROR
IPRED = F

Y = IPRED + IPRED * EPS(1) + EPS(2)

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV1
(0, 10) ; THETA(3) TVQ2
(0, 50) ; THETA(4) TVV2
(0, 10) ; THETA(5) TVQ3
(0, 50) ; THETA(6) TVV3

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V1
0.2         ; ETA(3) Q2
0.2         ; ETA(4) V2
0.2         ; ETA(5) Q3
0.2         ; ETA(6) V3

$SIGMA
0.1 ; Proportional variance
0.1 ; Additive variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE12.5
