$PROBLEM Indirect Response (inh_kin, linear) 1-cpt IV | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(CENTRAL) COMP=(RESPONSE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVR0 = THETA(3)
TVKOUT = THETA(4)

; Covariate effects
FBWV = (BW/70)**1

; PK parameters
CL = TVCL * EXP(ETA(1))
VC = TVVC * EXP(ETA(2)) * FBWV

; PD parameters
R0 = TVR0 * EXP(ETA(3))
KOUT = TVKOUT
KIN = R0 * KOUT
A_0(2) = R0
SLOPE = THETA(5)
S1 = VC

$DES
K10 = CL/VC
DADT(1) = -K10*A(1)
C2 = A(1)/VC
EFF = SLOPE*C2
DADT(2) = KIN*(1-EFF) - KOUT*A(2)

$ERROR
PKCONC = A(1)/VC
PDRESP = A(2)

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.1.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.2.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVVC
(0, 10) ; THETA(3) TVR0
(0, 0.1) ; THETA(4) TVKOUT
(0, 1) ; THETA(5) TVSLOPE

$OMEGA
BLOCK(2)
0.2         ; ETA(1) CL
0.01 0.2    ; ETA(2) VC

$OMEGA
0.2         ; ETA(3) R0

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE12.5
