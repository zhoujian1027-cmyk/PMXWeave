$PROBLEM 2-cpt IV_bolus Model | BAYES | add | TVCL

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN3 TRANS4

$PK
; Typical values
TVCLBASE = THETA(1)
TVV1 = THETA(2)
TVQ = THETA(3)
TVV2 = THETA(4)
TVEMAX = THETA(6)
TVCLT50 = THETA(7)
TVGAMMA = THETA(8)

; Covariate effects
FBWCL = (BW/70)**0.75
FBWV = (BW/70)**1
FAGE = (AGE/40)**THETA(5)

; Individual parameters
CLBASE = TVCLBASE * EXP(ETA(1)) * FBWCL * FAGE
EMAX = TVEMAX + ETA(5)
CLT50 = TVCLT50
GAMMA = TVGAMMA
CL = CLBASE*EXP((EMAX*(TIME**GAMMA))/(CLT50**GAMMA + TIME**GAMMA))
V1 = TVV1 * EXP(ETA(2)) * FBWV
Q = TVQ * EXP(ETA(3))
V2 = TVV2 * EXP(ETA(4))
S1 = V1

$ERROR
IPRED = F

Y = IPRED + EPS(1)

$THETA
(0, 5) ; THETA(1) TVCLBASE
(0, 50) ; THETA(2) TVV1
(0, 10) ; THETA(3) TVQ
(0, 50) ; THETA(4) TVV2
(0, 1) ; THETA(5) AGEPWR
0.1   ; THETA(6) TVEMAX
(0.01, 24) ; THETA(7) TVCLT50
(0.1, 1, 10) ; THETA(8) TVGAMMA

$OMEGA
0.2         ; ETA(1) CLBASE
0.2         ; ETA(2) V1
0.2         ; ETA(3) Q
0.2         ; ETA(4) V2
0.2         ; ETA(5) EMAX

$SIGMA
0.1 ; Additive variance

$PRIOR NWPRI

$THETAP
5 FIX
50 FIX
10 FIX
50 FIX
1 FIX
0.1 FIX
24 FIX
1 FIX

$THETAPV BLOCK(8) FIX
1000
0 1000
0 0 1000
0 0 0 1000
0 0 0 0 1000
0 0 0 0 0 1000
0 0 0 0 0 0 1000
0 0 0 0 0 0 0 1000

$ESTIMATION METHOD=BAYES INTERACTION FILE=bayes_output

; $COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output FORMAT=1PE10.4
