$PROBLEM 1-cpt PO Model | FOCE | logAdd

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN2 TRANS2

$PK
; Typical values
TVCL = THETA(1)
TVV = THETA(2)
TVKA = THETA(3)

; Covariate effects
FBWV = (BW/70)**1

; Individual parameters
CL = TVCL * EXP(ETA(1))
V = TVV * EXP(ETA(2)) * FBWV
KA = TVKA * EXP(ETA(3))
S2 = V

$ERROR
PKCONC = F

IPRED = LOG(0.0001)
IF (PKCONC.GT.0) IPRED = LOG(PKCONC)

Y = IPRED + EPS(1)

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV
(0, 1) ; THETA(3) TVKA

$OMEGA
BLOCK(2)
0.2         ; ETA(1) CL
0.01 0.2    ; ETA(2) V

$OMEGA
0.2         ; ETA(3) KA

$SIGMA
0.1 ; Log additive variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output
