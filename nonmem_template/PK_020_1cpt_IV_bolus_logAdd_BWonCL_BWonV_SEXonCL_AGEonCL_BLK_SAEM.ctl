$PROBLEM 1-cpt IV_bolus Model | SAEM | logAdd

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX AGE

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN1 TRANS2

$PK
; Typical values
TVCL = THETA(1)
TVV = THETA(2)

; MU references
MU_1 = LOG(TVCL)
MU_2 = LOG(TVV)

; Covariate effects
FBWCL = (BW/70)**0.75
FBWV = (BW/70)**1
IF (SEX.EQ.2) THEN
  FSEX = THETA(3)
ELSE
  FSEX = 1
ENDIF
FAGE = (AGE/40)**THETA(4)

; Individual parameters
CL = EXP(MU_1 + ETA(1)) * FBWCL * FSEX * FAGE
V = EXP(MU_2 + ETA(2)) * FBWV
S1 = V

$ERROR
PKCONC = F

IPRED = LOG(0.0001)
IF (PKCONC.GT.0) IPRED = LOG(PKCONC)

Y = IPRED + EPS(1)

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV
1 ; THETA(3) SEXEFF
(0, 1) ; THETA(4) AGEPWR

$OMEGA
BLOCK(2)
0.2         ; ETA(1) CL
0.01 0.2    ; ETA(2) V

$SIGMA
0.1 ; Log additive variance

$ESTIMATION METHOD=SAEM INTERACTION NBURN=2000 NITER=1000

$ESTIMATION METHOD=IMP EONLY=1 ISAMPLE=1000 NITER=5
; $COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output
