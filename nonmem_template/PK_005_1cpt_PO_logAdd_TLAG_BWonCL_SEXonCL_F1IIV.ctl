$PROBLEM 1-cpt PO Model | FOCE | logAdd

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN2 TRANS2

$PK
; Typical values
TVCL = THETA(1)
TVV = THETA(2)
TVKA = THETA(3)
TVLAG = THETA(4)
TVF1 = THETA(6)

; Covariate effects
FBWCL = (BW/70)**0.75
IF (SEX.EQ.2) THEN
  FSEX = THETA(5)
ELSE
  FSEX = 1
ENDIF

; Individual parameters
CL = TVCL * EXP(ETA(1)) * FBWCL * FSEX
V = TVV * EXP(ETA(2))
KA = TVKA * EXP(ETA(3))
ALAG1 = TVLAG * EXP(ETA(4))
LGTF1_TV = LOG(TVF1/(1.0-TVF1))
LGTF1 = LGTF1_TV + ETA(5)
F1 = EXP(LGTF1)/(1+EXP(LGTF1))
S2 = V

$ERROR
PKCONC = F

IPRED = LOG(0.0001)
IF (PKCONC.GT.0) IPRED = LOG(PKCONC)

Y = IPRED + EPS(1)

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVV
(0, 1) ; THETA(3) TVKA
(0, 1) ; THETA(4) TVLAG
1 ; THETA(5) SEXEFF
(0, 0.5, 1) ; THETA(6) TVF1

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) V
0.2         ; ETA(3) KA
0.2         ; ETA(4) ALAG
0.2         ; ETA(5) F1

$SIGMA
0.1 ; Log additive variance

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CWRES NOPRINT ONEHEADER FILE=output
