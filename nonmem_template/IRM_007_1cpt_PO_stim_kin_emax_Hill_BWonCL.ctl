$PROBLEM Indirect Response (stim_kin, emax) 1-cpt PO | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(DEPOT) COMP=(CENTRAL) COMP=(RESPONSE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVKA = THETA(3)
TVR0 = THETA(5)
TVKOUT = THETA(6)
TVEMAX = THETA(7)

; Covariate effects
FBWCL = (BW/70)**0.75
FBWV = (BW/70)**1
IF (SEX.EQ.2) THEN
  FSEX = THETA(4)
ELSE
  FSEX = 1
ENDIF

; PK parameters
CL = TVCL * EXP(ETA(1)) * FBWCL * FSEX
VC = TVVC * EXP(ETA(2)) * FBWV
KA = TVKA * EXP(ETA(3))

; PD parameters
R0 = TVR0 * EXP(ETA(4))
KOUT = TVKOUT * EXP(ETA(5))
KIN = R0 * KOUT
A_0(3) = R0
EMAX = TVEMAX * EXP(ETA(6))
IC50 = THETA(8)
GAMMA = THETA(9)
S2 = VC

$DES
K12 = KA
K20 = CL/VC
DADT(1) = -K12*A(1)
DADT(2) = K12*A(1) - K20*A(2)
C2 = A(2)/VC
EFF = EMAX*C2**GAMMA/(C2**GAMMA+IC50**GAMMA)
DADT(3) = KIN*(1+EFF) - KOUT*A(3)

$ERROR
PKCONC = A(2)/VC
PDRESP = A(3)

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.2.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.3.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVVC
(0, 1) ; THETA(3) TVKA
1 ; THETA(4) SEXEFF
(0, 10) ; THETA(5) TVR0
(0, 0.1) ; THETA(6) TVKOUT
(0, 10) ; THETA(7) TVEMAX
(0, 100) ; THETA(8) TVIC50
(0.1, 1, 10) ; THETA(9) TVGAMMA

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) VC
0.2         ; ETA(3) KA
0.2         ; ETA(4) R0
0.2         ; ETA(5) KOUT
0.2         ; ETA(6) EMAX

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT CWRES NOPRINT ONEHEADER FILE=output FORMAT=1F12.5
