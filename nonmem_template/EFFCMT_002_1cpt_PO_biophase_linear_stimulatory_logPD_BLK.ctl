$PROBLEM Effect Compartment (linear, stimulatory) 1-cpt PO | FOCE

$INPUT ID TIME DV AMT EVID CMT MDV ADDL II RATE STUDYID BW SEX

$DATA pk_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(DEPOT) COMP=(CENTRAL) COMP=(BIOPHASE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVKA = THETA(3)
TVKE0 = THETA(5)

; Covariate effects
FBWV = (BW/70)**1
IF (SEX.EQ.2) THEN
  FSEX = THETA(4)
ELSE
  FSEX = 1
ENDIF

; PK parameters
CL = TVCL * EXP(ETA(1)) * FSEX
VC = TVVC * EXP(ETA(2)) * FBWV
KA = TVKA * EXP(ETA(3))

; PD parameters
KE0 = TVKE0 * EXP(ETA(4))
E0 = THETA(6)
SLOPE = THETA(7)

$DES
K12 = KA
K20 = CL/VC
DADT(1) = -K12*A(1)
DADT(2) = K12*A(1) - K20*A(2)
C2 = A(2)/VC
DADT(3) = KE0*(C2 - A(3))

$ERROR
EFFECTCONC = A(3)
PDRESP = E0 + SLOPE*EFFECTCONC
PKCONC = A(2)/VC

IPRED = LOG(0.0001)
Y     = IPRED

IF (CMT.EQ.2.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (CMT.EQ.3.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 5) ; THETA(1) TVCL
(0, 50) ; THETA(2) TVVC
(0, 1) ; THETA(3) TVKA
1 ; THETA(4) SEXEFF
(0, 1) ; THETA(5) TVKE0
(0, 10) ; THETA(6) TVE0
(0, 1) ; THETA(7) TVSLOPE

$OMEGA
BLOCK(2)
0.2         ; ETA(1) CL
0.01 0.2    ; ETA(2) VC

$OMEGA
0.2         ; ETA(3) KA
0.2         ; ETA(4) KE0

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT PDRESP CWRES NOPRINT ONEHEADER FILE=output
