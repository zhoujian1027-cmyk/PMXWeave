$PROBLEM Indirect Response (inh_kout, emax) 2-cpt IV | FOCE

$INPUT ID TIME DV=DROP DV=LNDV AMT EVID CMT MDV ADDL II RATE STUDYID DVID BW SEX AGE RACE WTBL BMI ALB CRCL DOSE=DROP

$DATA pkpd_data.csv IGNORE=@

$SUBROUTINES ADVAN13 TOL=9

$MODEL COMP=(CENTRAL) COMP=(PERIPH) COMP=(RESPONSE)

$PK
; Typical values
TVCL = THETA(1)
TVVC = THETA(2)
TVQ = THETA(3)
TVVP = THETA(4)
TVE0 = THETA(5)
TVKOUT = THETA(6)
TVIMAX = THETA(7)
TVIC50 = THETA(8)

; PK parameters
CL = TVCL * EXP(ETA(1))
VC = TVVC * EXP(ETA(2))
Q = TVQ
VP = TVVP

; PD parameters (turnover)
E0 = TVE0 * EXP(ETA(3))
KOUT = TVKOUT * EXP(ETA(4))
KIN = E0 * KOUT
R0 = KIN/KOUT
A_0(3) = R0
IMAX = TVIMAX
IC50 = TVIC50

$DES
K10 = CL/VC
K12 = Q/VC
K21 = Q/VP
DADT(1) = -K10*A(1) - K12*A(1) + K21*A(2)
DADT(2) = K12*A(1) - K21*A(2)
C1 = A(1)/VC
EFF = IMAX*C1/(IC50+C1)
DADT(3) = KIN - KOUT*(1-EFF)*A(3)

$ERROR
PKCONC = A(1)/VC
PDRESP = A(3)

IPRED = LOG(0.0001)
Y     = IPRED

IF (DVID.EQ.1.AND.PKCONC.GT.0) THEN
  IPRED = LOG(PKCONC)
  Y = IPRED + EPS(1)
ENDIF

IF (DVID.EQ.2.AND.PDRESP.GT.0) THEN
  IPRED = LOG(PDRESP)
  Y = IPRED + EPS(2)
ENDIF

$THETA
(0, 8)  ; THETA(1) TVCL
(0, 40) ; THETA(2) TVVC
(0, 12) ; THETA(3) TVQ
(0, 30) ; THETA(4) TVVP
(0, 7)  ; THETA(5) TVE0
(0, 0.1); THETA(6) TVKOUT
(0, 1)  ; THETA(7) TVIMAX
(0, 1)  ; THETA(8) TVIC50

$OMEGA
0.2         ; ETA(1) CL
0.2         ; ETA(2) VC
0.2         ; ETA(3) E0
0.2         ; ETA(4) KOUT

$SIGMA
0.1 ; PK log-additive error
0.1 ; PD log-additive error

$ESTIMATION METHOD=1 INTER MAXEVAL=9999 SIGL=9 NOABORT

$COVARIANCE UNCONDITIONAL PRINT=E

$TABLE ID TIME DV PRED IPRED CMT CWRES AMT MDV ADDL II RATE STUDYID DVID BW SEX AGE RACE WTBL BMI ALB CRCL NOPRINT ONEHEADER FILE=output
